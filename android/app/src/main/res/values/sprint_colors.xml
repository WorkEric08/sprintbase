<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Fundo do app no tema claro (igual a utils/theme.ts e ao gray-50 do Tailwind). -->
    <color name="sprint_window_background">#f9fafb</color>
    <!-- Abertura no Android 11 e anteriores: o plugin SplashScreen do Capacitor procura o drawable "splash".
         Aqui ele é só um fundo liso da cor do app (claro/escuro seguem o modo do aparelho). -->
    <drawable name="splash">@color/sprint_window_background</drawable>
</resources>
