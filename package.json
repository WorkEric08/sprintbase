{
  "name": "sprint-base",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:android": "vite build --mode android",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "android:sync": "node scripts/android.mjs sync",
    "android:build": "node scripts/android.mjs build",
    "android:install": "node scripts/android.mjs install",
    "android:run": "node scripts/android.mjs run",
    "android:devices": "node scripts/android.mjs devices",
    "icons": "node scripts/generate-icons.mjs && capacitor-assets generate --android",
    "e2e": "node scripts/e2e/run.mjs",
    "android:release": "node scripts/android.mjs release",
    "android:install-release": "node scripts/android.mjs install-release",
    "perf": "node scripts/perf/startup.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "dexie": "^4.4.2",
    "preact": "^11.0.1",
    "react": "^19.2.4",
    "react-colorful": "^5.6.1",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.18",
    "fake-indexeddb": "^6.2.6",
    "postcss": "^8.4.35",
    "puppeteer-core": "^25.15.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.1",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
